# Copy to /etc/panoseti/dome-temperature.env on each DAQ node and edit for
# that machine. Values here override defaults in dome-temp-telemetry.service.

# pseti-grpc executable for the Python environment used on this DAQ node.
PSETI_GRPC_BIN=/home/panoseti/anaconda3/envs/py314/bin/pseti-grpc

# Per-dome config file. Keep the checked-in TOML as an example; deploy a
# machine-specific copy under /etc/panoseti or another local config directory.
DOME_TEMPERATURE_CONFIG=/etc/panoseti/dome-temperature.toml

# Optional extra flags, for example:
# DOME_TEMPERATURE_FLAGS=--verbose
DOME_TEMPERATURE_FLAGS=
