[Unit]
Description=PANOSETI dome environmental telemetry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Optional local overrides. Copy systemd/dome-temperature.env.example to this
# path on each DAQ node and edit paths/flags for that machine.
EnvironmentFile=-/etc/panoseti/dome-temperature.env
Environment=PYTHONUNBUFFERED=1
Environment=PSETI_GRPC_BIN=/opt/panoseti/bin/pseti-grpc
Environment=DOME_TEMPERATURE_CONFIG=/etc/panoseti/dome-temperature.toml
Environment=DOME_TEMPERATURE_FLAGS=
ExecStart=/bin/sh -c 'exec "$PSETI_GRPC_BIN" dome-temperature --config "$DOME_TEMPERATURE_CONFIG" $DOME_TEMPERATURE_FLAGS'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
